# Slack credentials (Socket Mode app)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# How long after a trigger (and after each reminder) before nudging again
REMINDER_INTERVAL_HOURS=24

# How often the reminder loop wakes to check for due workflows
REMINDER_CHECK_INTERVAL_SECONDS=300
