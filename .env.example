# Slack credentials (Socket Mode app)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# How long after a trigger (and after each reminder) before nudging again
REMINDER_INTERVAL_HOURS=24

# How often the reminder loop wakes to check for due workflows
REMINDER_CHECK_INTERVAL_SECONDS=300

# Slack user group to @-mention in reminders (e.g. @legalassistants)
# Find the group ID: right-click the group name in Slack → Copy link → ID is S12345678
NOTIFY_GROUP_ID=
NOTIFY_GROUP_NAME=legalassistants
